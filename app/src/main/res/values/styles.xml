<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B49AFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B0D18</item>
        <item name="android:navigationBarColor">#111523</item>
        <item name="android:windowBackground">#0B0D18</item>
        <item name="android:colorButtonNormal">#25263F</item>
        <item name="android:textColorPrimary">#F4F1FF</item>
        <item name="android:textColorSecondary">#B8BDD0</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Body"><item name="android:textColor">#BEC4D6</item><item name="android:textSize">15sp</item><item name="android:lineSpacingExtra">4dp</item></style>
    <style name="Heading"><item name="android:textColor">#F4F1FF</item><item name="android:textSize">24sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Action" parent="android:style/Widget.Material.Button"><item name="android:textAllCaps">false</item><item name="android:minHeight">52dp</item><item name="android:textColor">#FFFFFF</item><item name="android:backgroundTint">#6D49CE</item></style>
    <style name="Nav" parent="android:style/Widget.Material.Button.Borderless"><item name="android:textAllCaps">false</item><item name="android:textSize">12sp</item><item name="android:padding">0dp</item><item name="android:minWidth">0dp</item><item name="android:textColor">#D8D2F2</item></style>
</resources>
