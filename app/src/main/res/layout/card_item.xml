<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical" android:background="@drawable/card">
    <TextView android:id="@+id/cardTag" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#A693F4" android:letterSpacing="0.06"/>
    <TextView android:id="@+id/cardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="19sp" android:textStyle="bold" android:textColor="#F4F1FF"/>
    <TextView android:id="@+id/cardBody" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <LinearLayout android:id="@+id/cardActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
